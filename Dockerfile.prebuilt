# Imaging Atlas — offline variant. One base image, no build.
#
# Use this when the server cannot pull a node image: a hospital VM with no
# route to Docker Hub can only use what it already has cached, which after the
# old deployment is some flavour of nginx.
#
# The site is built and pre-compressed BEFORE it reaches the server, into
# `site/` — see START-HERE.md. That directory is the same `dist/` the normal
# Dockerfile produces, so both routes serve identical bytes; this one simply
# does the work somewhere that has npm.
#
#   docker build -f Dockerfile.prebuilt -t imaging-atlas:1.1.0 .
#   NGINX_IMAGE=nginx:alpine docker build -f Dockerfile.prebuilt -t imaging-atlas:1.1.0 .
#
# What is given up: the data-stamp check cannot run here, because there is no
# node in an nginx image. It runs at packaging time instead, and site/build.json
# still records the hash and the gate verdicts, still served at /build.json.
ARG NGINX_IMAGE=nginx:1.27-alpine
FROM ${NGINX_IMAGE}

RUN rm -f /etc/nginx/conf.d/default.conf

COPY nginx.conf /etc/nginx/conf.d/atlas.conf
COPY nginx-security-headers.conf /etc/nginx/security-headers.conf
COPY site /usr/share/nginx/html

# Parse the configuration at build time: an unsupported directive breaks the
# build here rather than putting the container into a restart loop on the VM.
RUN nginx -t \
 && test -f /usr/share/nginx/html/index.html \
 && test -f /usr/share/nginx/html/build.json \
 && echo "site: $(find /usr/share/nginx/html -type f | wc -l) files, $(du -sh /usr/share/nginx/html | cut -f1)"

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
