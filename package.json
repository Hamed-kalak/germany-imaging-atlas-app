    "recharts": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.2.2",
